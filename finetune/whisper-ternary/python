#!/usr/bin/env bash
# Pinned interpreter for the ternary Whisper experiment. See DESIGN.md.
# Uses the existing Nix CUDA runtime plus the hashed transformers install in
# finetune/stt/deps. All caches and artifacts live on the mounted data disk.
set -euo pipefail
mountpoint -q /mnt/hd || { echo '/mnt/hd is not mounted; refusing artifact writes.' >&2; exit 1; }
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo="$(cd -- "$here/../.." && pwd)"
art=/mnt/hd/wilderness-labs-stt/whisper-ternary
mkdir -p "$art/tmp" "$art/cache"
export PYTHONPATH="$here:$repo/finetune/stt/deps${PYTHONPATH:+:$PYTHONPATH}"
export HF_HOME="$art/cache/huggingface" HF_HUB_CACHE="$art/cache/huggingface/hub"
export XDG_CACHE_HOME="$art/cache" TORCH_HOME="$art/cache/torch"
export TORCHINDUCTOR_CACHE_DIR="$art/cache/inductor" TRITON_CACHE_DIR="$art/cache/triton"
export TORCH_EXTENSIONS_DIR="$art/cache/extensions" CUDA_CACHE_PATH="$art/cache/cuda"
export TMPDIR="$art/tmp"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 DO_NOT_TRACK=1
export TOKENIZERS_PARALLELISM=false PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}" MKL_NUM_THREADS="${MKL_NUM_THREADS:-4}"
export TRITON_LIBCUDA_PATH=/run/opengl-driver/lib
# zlib: the same store path the pinned Nix Python links; the numpy wheel in deps needs it.
export LD_LIBRARY_PATH="/run/opengl-driver/lib:/nix/store/hngmi01i8wgi25a0byrxcn4ysz5j79mw-gcc-15.2.0-lib/lib:/nix/store/dbz6pb9g67kpgpl95k8d85kzpxm1c32p-zlib-1.3.2/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$repo/custom/autoresearch/.training-runtime/bin/python3" "$@"
