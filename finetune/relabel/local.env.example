# Machine-specific roots for finetune/relabel. Copy to private/local.env (gitignored) and fill in.
# Keys already set in the environment take precedence.
DATA_MOUNT=/path/to/data-mount
DATA_ROOT=/path/to/data-mount/project
RELABEL_ROOT=/path/to/data-mount/project/relabel
PRIVATE_REGISTRY=/path/to/data-mount/project/relabel/private
PARAKEET_TERNARY_ROOT=/path/to/data-mount/project/parakeet-ternary
PARAKEET_BINARY_ROOT=/path/to/data-mount/project/parakeet-binary
SHARED_RUNTIME=/path/to/repo/custom/stt-distillation/python
