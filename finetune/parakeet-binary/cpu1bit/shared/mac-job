#!/usr/bin/env bash
# Run cargo in a pushed Mac workspace as a supervised, low-priority job on the Mac:
#   cpu1bit/shared/mac-job AGENT NAME [job options] -- CARGO_ARGS...
# e.g. cpu1bit/shared/push.py code --agent V
#      cpu1bit/shared/mac-job V contract -- test --release --locked -p v_sdot
#      job wait cpu1bit-V-contract --host mac --timeout 110m
# The job holds the Mac-side shared lock (shared/mac/withlock) for its lifetime.
set -euo pipefail
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
[[ $# -ge 3 ]] || { sed -n 2,7p "$0" >&2; exit 2; }
agent=$1 name=$2; shift 2
opts=()
while [[ $# -gt 0 && $1 != -- ]]; do opts+=("$1"); shift; done
[[ ${1:-} == -- ]] || { echo "missing -- before cargo arguments" >&2; exit 2; }
shift
ws="$("$here/mac-root")/ws/$agent"
exec job start "cpu1bit-$agent-$name" --host mac --cwd "$ws" --stall 30m --timeout 3h "${opts[@]}" -- "$ws/shared/mac/cargo" "$@"
