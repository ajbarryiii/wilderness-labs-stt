  {"id": "n08-1993-147965-0003", "kind": "natural", "bucket": 8, "length": 118000, "seconds": 7.375, "mel_frames": 737, "encoder_frames": 93, "fluidaudio_frames": 93, "source": "LibriSpeech/dev-clean/1993/147965/1993-147965-0003.flac", "utterance": "1993-147965-0003", "offset": 0, "transcript": "BECAUSE HE TALKED SO LITTLE HIS WORDS HAD A PECULIAR FORCE THEY WERE NOT WORN DULL FROM CONSTANT USE", "tags": [], "sha256": "a0f5affd66df30702e3296c53f1afb89ede9a9a13b3ca51ff355019063ca5d1c"},
  {"id": "n08-2086-149220-0016", "kind": "natural", "bucket": 8, "length": 120320, "seconds": 7.52, "mel_frames": 752, "encoder_frames": 94, "fluidaudio_frames": 94, "source": "LibriSpeech/dev-clean/2086/149220/2086-149220-0016.flac", "utterance": "2086-149220-0016", "offset": 0, "transcript": "MISS HEPZIBAH I SUPPOSE WILL INTERWEAVE THE FACT WITH HER OTHER TRADITIONS AND SET IT DOWN THAT THE FOWLS KNOW YOU TO BE A PYNCHEON", "tags": [], "sha256": "6ae9d954de2d8afd52a08aa714255e789c806ebaf6c2c1149e7aedc19022bd34"},
  {"id": "n08-2277-149897-0033", "kind": "natural", "bucket": 8, "length": 81040, "seconds": 5.065, "mel_frames": 506, "encoder_frames": 64, "fluidaudio_frames": 64, "source": "LibriSpeech/dev-clean/2277/149897/2277-149897-0033.flac", "utterance": "2277-149897-0033", "offset": 0, "transcript": "ON WEDNESDAY HE RECEIVED ANOTHER POLITE NOTE FROM MC GREGOR JAMES AND HAY IT READ", "tags": [], "sha256": "443c45340b5f1052c0b35552cd37a9a0e03deef492a63f5507c95ac380c44efb"},
  {"id": "n08-2412-153948-0009", "kind": "natural", "bucket": 8, "length": 95920, "seconds": 5.995, "mel_frames": 599, "encoder_frames": 75, "fluidaudio_frames": 75, "source": "LibriSpeech/dev-clean/2412/153948/2412-153948-0009.flac", "utterance": "2412-153948-0009", "offset": 0, "transcript": "IT WAS A MONOTONOUS LIFE BUT IT WAS VERY HEALTHY AND ONE DOES NOT MUCH MIND ANYTHING WHEN ONE IS WELL", "tags": [], "sha256": "390e1c59f00d6bddd580ae308908b8ef165a2b7e10779f5562b910dd1353d2d7"},
  {"id": "n08-2803-154320-0010", "kind": "natural", "bucket": 8, "length": 64160, "seconds": 4.01, "mel_frames": 401, "encoder_frames": 51, "fluidaudio_frames": 51, "source": "LibriSpeech/dev-clean/2803/154320/2803-154320-0010.flac", "utterance": "2803-154320-0010", "offset": 0, "transcript": "WE WOULD FIGHT TO THE DEATH OF COURSE BUT AFTER THAT", "tags": [], "sha256": "b37a0c8fe175b45bd5b0e25137b6a81f486de4f270cb79a99350b359bb8ac468"},
  {"id": "n08-3853-163249-0041", "kind": "natural", "bucket": 8, "length": 114240, "seconds": 7.14, "mel_frames": 714, "encoder_frames": 90, "fluidaudio_frames": 90, "source": "LibriSpeech/dev-clean/3853/163249/3853-163249-0041.flac", "utterance": "3853-163249-0041", "offset": 0, "transcript": "WE WILL WHAT CAN I DO FOR YOU DAVY ASKED CHRISTIE WONDERFULLY SUPPORTED BY THE THOUGHT THAT SHE WAS GOING TOO", "tags": [], "sha256": "9eeb92f6adb03bba0cc3ab4c6c1d1892ff2c295b0494cf59afb4ed810f79c6fa"},
  {"id": "n08-5338-284437-0029", "kind": "natural", "bucket": 8, "length": 121280, "seconds": 7.58, "mel_frames": 758, "encoder_frames": 95, "fluidaudio_frames": 95, "source": "LibriSpeech/dev-clean/5338/284437/5338-284437-0029.flac", "utterance": "5338-284437-0029", "offset": 0, "transcript": "YES IT WAS WET AN STICKY ALL RIGHT AGREED THE SAILOR BUT THE BIG FROG HELPED US AN WE GOT THROUGH ALL RIGHT", "tags": [], "sha256": "70da539af856856a447c61fcf149875142bde38ed01c49381069602c2b95f842"},
  {"id": "n08-5694-64025-0020", "kind": "natural", "bucket": 8, "length": 117600, "seconds": 7.35, "mel_frames": 735, "encoder_frames": 92, "fluidaudio_frames": 92, "source": "LibriSpeech/dev-clean/5694/64025/5694-64025-0020.flac", "utterance": "5694-64025-0020", "offset": 0, "transcript": "MULE DID NOT DESIRE TO CROSS WHILE I WAS TRYING TO PERSUADE HIM WITH A BIG STICK A ROCK IN HIS EAR AND A TWISTER ON HIS NOSE", "tags": [], "sha256": "c103ada824a063eee9fe02a6f41bcb93d0f396d66e4627e7b8a4da3003c61adc"},
  {"id": "n08-6313-76958-0016", "kind": "natural", "bucket": 8, "length": 69600, "seconds": 4.35, "mel_frames": 435, "encoder_frames": 55, "fluidaudio_frames": 55, "source": "LibriSpeech/dev-clean/6313/76958/6313-76958-0016.flac", "utterance": "6313-76958-0016", "offset": 0, "transcript": "YOU WON'T BE SO FAST TO WAKE UP HARD WORKING COWBOYS AFTER THAT I RECKON", "tags": [], "sha256": "58faf9bfbd7200a8d6322992682d0f83ac1a7a95f92e213706c272a193cc4d8c"},
  {"id": "n08-6345-93306-0019", "kind": "natural", "bucket": 8, "length": 122720, "seconds": 7.67, "mel_frames": 767, "encoder_frames": 96, "fluidaudio_frames": 96, "source": "LibriSpeech/dev-clean/6345/93306/6345-93306-0019.flac", "utterance": "6345-93306-0019", "offset": 0, "transcript": "YOU SEE PAPA'S SO VERY RICH AND AT HOME THEY EXPECT ME TO TO GET ACQUAINTED WITH DUKES AND THINGS AND SHE STOPPED", "tags": [], "sha256": "15e8f631806a4629fe3bfc69efb34cd5a9189f8820dcc2d985b7a7a0e17cacaf"},
  {"id": "n08-652-130726-0027", "kind": "natural", "bucket": 8, "length": 83760, "seconds": 5.235, "mel_frames": 523, "encoder_frames": 66, "fluidaudio_frames": 66, "source": "LibriSpeech/dev-clean/652/130726/652-130726-0027.flac", "utterance": "652-130726-0027", "offset": 0, "transcript": "PUT INTO THE OVEN AGAIN AND COOK FOR HALF AN HOUR BASTING FREQUENTLY WITH THE ORIGINAL BRINE", "tags": [], "sha256": "42d41a747c16124259781b5c684f3debca1f4034ee47b549c10d1fed7c3cf194"},
  {"id": "n08-8842-302201-0007", "kind": "natural", "bucket": 8, "length": 77680, "seconds": 4.855, "mel_frames": 485, "encoder_frames": 61, "fluidaudio_frames": 61, "source": "LibriSpeech/dev-clean/8842/302201/8842-302201-0007.flac", "utterance": "8842-302201-0007", "offset": 0, "transcript": "TO HER I WEND ALONG IN WHOSE MUCH STRENGTH MY WEAKNESS IS MADE STRONG", "tags": [], "sha256": "d7d06564f265969c5693f73f1ea2ed86518079487eb490c45b8d7fb220542732"},
  {"id": "n15-1272-141231-0025", "kind": "natural", "bucket": 15, "length": 139600, "seconds": 8.725, "mel_frames": 872, "encoder_frames": 109, "fluidaudio_frames": 110, "source": "LibriSpeech/dev-clean/1272/141231/1272-141231-0025.flac", "utterance": "1272-141231-0025", "offset": 0, "transcript": "OTHERS HAD DIED BEFORE DURING THE TWENTIES AND DEATH DURING THE LAST ROUND WAS IN SOME WAYS EASIER THAN DEFEAT", "tags": [], "sha256": "1751c343220036225785f69383bbb70f58d4caf27b6bf16ff7c13fc7bd1f531f"},
  {"id": "n15-1462-170142-0001", "kind": "natural", "bucket": 15, "length": 153360, "seconds": 9.585, "mel_frames": 958, "encoder_frames": 120, "fluidaudio_frames": 120, "source": "LibriSpeech/dev-clean/1462/170142/1462-170142-0001.flac", "utterance": "1462-170142-0001", "offset": 0, "transcript": "EMERGING AT EUSTON AT HALF PAST THREE O'CLOCK IN THE AFTERNOON ALEXANDER HAD HIS LUGGAGE SENT TO THE SAVOY AND DROVE AT ONCE TO BEDFORD SQUARE", "tags": [], "sha256": "b81a2c3458319414efd13a98901ea68452f4246241391608d5ae2fe5304f832a"},
  {"id": "n15-1673-143396-0001", "kind": "natural", "bucket": 15, "length": 224800, "seconds": 14.05, "mel_frames": 1405, "encoder_frames": 176, "fluidaudio_frames": 176, "source": "LibriSpeech/dev-clean/1673/143396/1673-143396-0001.flac", "utterance": "1673-143396-0001", "offset": 0, "transcript": "THEIR CHURCHES HAVE DISAPPEARED THEIR BOOKS ARE OBLITERATED THEIR OBSCURE FREEDOM MIGHT ALLOW A LATITUDE OF FAITH AND THE SOFTNESS OF THEIR INFANT CREED WOULD BE VARIOUSLY MOULDED BY THE ZEAL OR PRUDENCE OF THREE HUNDRED YEARS", "tags": [], "sha256": "9836c344fa6cd6c4cc374a7ffb093a1e4ae6711ce6b3342bfd31a6582f88ddba"},
  {"id": "n15-174-168635-0010", "kind": "natural", "bucket": 15, "length": 160960, "seconds": 10.06, "mel_frames": 1006, "encoder_frames": 126, "fluidaudio_frames": 126, "source": "LibriSpeech/dev-clean/174/168635/174-168635-0010.flac", "utterance": "174-168635-0010", "offset": 0, "transcript": "WHEN THESE TWO SOULS PERCEIVED EACH OTHER THEY RECOGNIZED EACH OTHER AS NECESSARY TO EACH OTHER AND EMBRACED EACH OTHER CLOSELY", "tags": [], "sha256": "71df723cdaa14d9a204d8eec1522d1347b806e799c61ce6b9f48fb9e5e35c94c"},
  {"id": "n15-2277-149874-0014", "kind": "natural", "bucket": 15, "length": 137600, "seconds": 8.6, "mel_frames": 860, "encoder_frames": 108, "fluidaudio_frames": 108, "source": "LibriSpeech/dev-clean/2277/149874/2277-149874-0014.flac", "utterance": "2277-149874-0014", "offset": 0, "transcript": "SHE ASKED MINNIE FOR INK AND PAPER WHICH WERE UPON THE MANTEL IN THE DINING ROOM AND WHEN THE LATTER HAD GONE TO BED AT TEN GOT OUT DROUET'S CARD AND WROTE HIM", "tags": [], "sha256": "6db7058c7a7edaed875b18cc1ab34870e4ed7e7fe7a202f0e05c2e0013239d1c"},
  {"id": "n15-2412-153947-0005", "kind": "natural", "bucket": 15, "length": 218880, "seconds": 13.68, "mel_frames": 1368, "encoder_frames": 171, "fluidaudio_frames": 171, "source": "LibriSpeech/dev-clean/2412/153947/2412-153947-0005.flac", "utterance": "2412-153947-0005", "offset": 0, "transcript": "I AM SURPRISED HOWEVER THAT THE BOOK AT WHICH SUCH AN EXAMPLE OF THE SPECIOUS MISUSE OF ANALOGY WOULD SEEM MOST NATURALLY LEVELLED SHOULD HAVE OCCURRED TO NO REVIEWER NEITHER SHALL I MENTION THE NAME OF THE BOOK HERE THOUGH I SHOULD FANCY THAT THE HINT GIVEN WILL SUFFICE", "tags": [], "sha256": "0a15af44de2fc873d63e0f30d96411d2446cf6ce4fff04986fdf01e9209ca9d6"},
  {"id": "n15-3000-15664-0011", "kind": "natural", "bucket": 15, "length": 171680, "seconds": 10.73, "mel_frames": 1073, "encoder_frames": 135, "fluidaudio_frames": 135, "source": "LibriSpeech/dev-clean/3000/15664/3000-15664-0011.flac", "utterance": "3000-15664-0011", "offset": 0, "transcript": "SLIGHT RAINSTORMS ARE LIKELY TO BE ENCOUNTERED IN A TRIP ROUND THE MOUNTAIN BUT ONE MAY EASILY FIND SHELTER BENEATH WELL THATCHED TREES THAT SHED THE RAIN LIKE A ROOF", "tags": [], "sha256": "f9b21de7176dab0aa9d81651a18f8f454c310f1d5ae9ff9e833c268bb5e120a4"},
  {"id": "n15-3536-23268-0008", "kind": "natural", "bucket": 15, "length": 148640, "seconds": 9.29, "mel_frames": 929, "encoder_frames": 117, "fluidaudio_frames": 117, "source": "LibriSpeech/dev-clean/3536/23268/3536-23268-0008.flac", "utterance": "3536-23268-0008", "offset": 0, "transcript": "NOR HAD THIS GOOD WOMAN'S OFFICIOUS LABOURS TAKEN THE LEAST FROM THE AWKWARDNESS OF THE SILENCE WHICH AS SOON AS THE BUSTLE SHE HAD MADE WAS OVER RETURNED IN ITS FULL FORCE", "tags": [], "sha256": "73a2194fb64fba03af055e40064b1e587268977c194c492ab480f5020a27d0ce"},
  {"id": "n15-3752-4944-0027", "kind": "natural", "bucket": 15, "length": 182240, "seconds": 11.39, "mel_frames": 1139, "encoder_frames": 143, "fluidaudio_frames": 143, "source": "LibriSpeech/dev-clean/3752/4944/3752-4944-0027.flac", "utterance": "3752-4944-0027", "offset": 0, "transcript": "BEFORE THE TWO CLERGYMEN HAD GOT HALF WAY DOWN THE STEEP PATH THAT LED FROM THE COMMANDANT'S HOUSE TO THE FLAT ON WHICH THE COTTAGES OF THE DOCTOR AND CHAPLAIN WERE BUILT MACKLEWAIN REJOINED THEM", "tags": [], "sha256": "b86ab7320e34432c92f482dfbe46d6642269e3e9441f7397e8b747290a96dc19"},
  {"id": "n15-3853-163249-0022", "kind": "natural", "bucket": 15, "length": 136080, "seconds": 8.505, "mel_frames": 850, "encoder_frames": 107, "fluidaudio_frames": 107, "source": "LibriSpeech/dev-clean/3853/163249/3853-163249-0022.flac", "utterance": "3853-163249-0022", "offset": 0, "transcript": "YOU WILL LET ME DO IT AND IN RETURN I WILL MARRY YOU WHENEVER YOU ASK ME ANSWERED CHRISTIE SEALING THE PROMISE WITH A KISS THAT SILENCED HIM", "tags": [], "sha256": "47101699fa42ce7e6e4ff16e96a06317158097657d53ce858776a27c8970aaef"},
  {"id": "n15-422-122949-0008", "kind": "natural", "bucket": 15, "length": 148800, "seconds": 9.3, "mel_frames": 930, "encoder_frames": 117, "fluidaudio_frames": 117, "source": "LibriSpeech/dev-clean/422/122949/422-122949-0008.flac", "utterance": "422-122949-0008", "offset": 0, "transcript": "EVERYWHERE THAT SLAVE MORALITY GAINS THE ASCENDANCY LANGUAGE SHOWS A TENDENCY TO APPROXIMATE THE SIGNIFICATIONS OF THE WORDS GOOD AND STUPID", "tags": [], "sha256": "7fef63d8c56c7c2d1046a7b907d1ce2762c04d9d7c52e6dd2f49b6e2d5dc7907"},
  {"id": "n15-6241-61943-0008", "kind": "natural", "bucket": 15, "length": 129761, "seconds": 8.11006, "mel_frames": 811, "encoder_frames": 102, "fluidaudio_frames": 102, "source": "LibriSpeech/dev-clean/6241/61943/6241-61943-0008.flac", "utterance": "6241-61943-0008", "offset": 0, "transcript": "ON THE ELEVENTH DAY WE SIGHTED CAPE PORTLAND OVER WHICH TOWERED MOUNT MYRDALS YOKUL WHICH THE WEATHER BEING CLEAR WE MADE OUT VERY READILY", "tags": [], "sha256": "66c1fa3e7081232e4104528a2aeafaf0c09c4ca8a6a5e91635ac29c98d8f7d1a"},
  {"id": "n15-6313-76958-0013", "kind": "natural", "bucket": 15, "length": 188960, "seconds": 11.81, "mel_frames": 1181, "encoder_frames": 148, "fluidaudio_frames": 148, "source": "LibriSpeech/dev-clean/6313/76958/6313-76958-0013.flac", "utterance": "6313-76958-0013", "offset": 0, "transcript": "THE HORSES OF THE OUTFIT SAVE THOSE THAT WERE ON NIGHT DUTY AND TWO OR THREE OTHERS THAT HAD DEVELOPED A HABIT OF STRAYING HAD BEEN TURNED LOOSE EARLY IN THE EVENING FOR ANIMALS ON THE TRAIL ARE SELDOM STAKED DOWN", "tags": [], "sha256": "5b5a81fb9373464099b25d851277a3858a5e8250268c0101c3b1d1f4fe40c783"},
  {"id": "n15-652-129742-0001", "kind": "natural", "bucket": 15, "length": 138560, "seconds": 8.66, "mel_frames": 866, "encoder_frames": 109, "fluidaudio_frames": 109, "source": "LibriSpeech/dev-clean/652/129742/652-129742-0001.flac", "utterance": "652-129742-0001", "offset": 0, "transcript": "BIRDS NEST SALAD HAVE READY AS MANY CRISP LEAVES OF LETTUCE AS MAY BE REQUIRED TO MAKE A DAINTY LITTLE NEST FOR EACH PERSON", "tags": [], "sha256": "60bff4fab7ad2e30001acc1c2075d40c603002840ec67a11d0899cd460508448"},
  {"id": "n15-8297-275155-0005", "kind": "natural", "bucket": 15, "length": 130240, "seconds": 8.14, "mel_frames": 814, "encoder_frames": 102, "fluidaudio_frames": 102, "source": "LibriSpeech/dev-clean/8297/275155/8297-275155-0005.flac", "utterance": "8297-275155-0005", "offset": 0, "transcript": "MISSUS NORMAN AND HER LITTLE DAUGHTER WERE OUT DRIVING WITH A FRIEND AND WERE EXPECTED TO RETURN IN GOOD TIME FOR DINNER", "tags": [], "sha256": "f1670271a00ee0b4499d94c0f7a3f1533a0bd88f0f3d54107e4f16b35090b3dd"},
  {"id": "n15-84-121550-0029", "kind": "natural", "bucket": 15, "length": 134160, "seconds": 8.385, "mel_frames": 838, "encoder_frames": 105, "fluidaudio_frames": 105, "source": "LibriSpeech/dev-clean/84/121550/84-121550-0029.flac", "utterance": "84-121550-0029", "offset": 0, "transcript": "THEREFORE MY ANSWER IS WITH GREATER CARE THAT HE MAY HEAR ME WHO IS WEEPING YONDER SO THAT THE SIN AND DOLE BE OF ONE MEASURE", "tags": [], "sha256": "ba75eee2b7ea7410e73ca46f5db8d1cc79386e92fa09c1a32388106a083aca5d"},
  {"id": "b02-N31840", "kind": "boundary", "bucket": 2, "length": 31840, "seconds": 1.99, "mel_frames": 199, "encoder_frames": 25, "fluidaudio_frames": 25, "source": "LibriSpeech/dev-clean/3752/4944/3752-4944-0045.flac", "utterance": "3752-4944-0045", "offset": 10566, "transcript": null, "tags": ["stride_M199"], "sha256": "dd64ac350d44c33a4b60814042e738c04bde50aca302795653ef785475077002"},
