#!/bin/sh
# macguard front end (POSIX sh): same CLI and exit codes as macguard.py, which does the work; see its docstring.
#
# Why a front end: on macOS /usr/bin/python3 is an Xcode/CommandLineTools shim. It and Python's start-up
# inject variables into the environment (seen on the Mac: SDKROOT = the Command Line Tools SDK, CPATH,
# LIBRARY_PATH, MANPATH, LC_CTYPE, __CF_USER_TEXT_ENCODING), which every job used to inherit. A job such as
# `swift build` then compiles against the wrong SDK. This front end records the names of all caller variables
# (MACGUARD_CALLER_NAMES) and, for each of those variables, whether and how the caller had it
# (MACGUARD_CALLER_SET_<NAME> / MACGUARD_CALLER_VAL_<NAME>); macguard.py removes variables the caller did not
# have and restores exactly the caller's state of the listed ones immediately before it execs the job (the thread-cap
# variables it sets on purpose excepted). tests/macguard_tests.sh check 13 compares the job's environment
# with the caller's.
#
# Interpreter: /usr/bin/python3 (the Mac's system Python 3.9), else $MACGUARD_PYTHON (Linux tests).
# Names of every caller variable (a value spanning lines can at worst add a spurious name, which only means an
# injected variable of that name would survive): variables the interpreter adds are removed again.
MACGUARD_CALLER_NAMES=$(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')
export MACGUARD_CALLER_NAMES
for name in SDKROOT CPATH LIBRARY_PATH MANPATH LC_CTYPE __CF_USER_TEXT_ENCODING; do
  eval "if [ \"\${$name+set}\" = set ]; then MACGUARD_CALLER_SET_$name=1; MACGUARD_CALLER_VAL_$name=\$$name; \
else MACGUARD_CALLER_SET_$name=0; MACGUARD_CALLER_VAL_$name=; fi; export MACGUARD_CALLER_SET_$name MACGUARD_CALLER_VAL_$name"
done
here=$(cd -- "$(dirname -- "$0")" && pwd) || exit 2
py=/usr/bin/python3
[ -x "$py" ] || py=${MACGUARD_PYTHON:-}
[ -n "$py" ] || { echo "macguard: no /usr/bin/python3; set MACGUARD_PYTHON" >&2; exit 2; }
exec "$py" "$here/macguard.py" "$@"
