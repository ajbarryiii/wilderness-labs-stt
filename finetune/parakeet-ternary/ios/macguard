#!/usr/bin/python3
"""macguard: run one job on the shared Mac under memory, time and load guards. See DESIGN.md "Implementation decisions".

    macguard --rss-cap SIZE --timeout SECONDS [--min-free 40] [--abort-free 25] [--max-swap-growth 1G]
             [--threads 4] -- CMD ARGS...

Lock. One guarded job at a time: macguard takes fcntl.flock on the permanent file
<dir>/macguard.lockfile (refusing, exit 3, if it is held) and never unlocks it explicitly. The
locked file description is inherited by the job (pass_fds) and by the sentinel, so the lock is held
as long as the supervisor, the sentinel or any job process that kept the descriptor is alive. (A
job that closes inherited descriptors, e.g. Python's subprocess with close_fds, drops its copy;
the sentinel keeps the lock until the group is verified empty.) It then refuses, exit 3, unless the
system-wide free memory percentage (memory_pressure -Q) is at least --min-free.

Sentinel. Before the job starts, macguard forks a sentinel in its own session that holds the lock
and watches the supervisor through a control pipe (EOF = supervisor gone) and getppid, every
second. The supervisor tells it the job's process group and waits for its acknowledgement before
the job may run: the job is started as `macguard --exec-after-gate FD -- CMD`, which blocks on a
gate pipe and execs CMD only once the sentinel knows the group. If the supervisor dies (even by
SIGKILL), the sentinel terminates the group (SIGTERM, 5 s grace, SIGKILL until the kernel reports
it empty), logs, and exits, releasing the lock. In normal operation the supervisor tells it to exit
only after its own cleanup has verified the group empty.

Run. CMD runs in a new session and process group (pgid == pid, verified distinct from macguard's),
under nice 10, with OMP/BLAS/vecLib thread caps. Every second: summed RSS of the group from ps;
every 5 s: free memory and swap use. Abort (exit 124) when the group RSS exceeds --rss-cap, the
job runs past --timeout, free memory falls below --abort-free, swap use grows by more than
--max-swap-growth since the start, or any monitoring or logging step fails (fail closed: a failed
or malformed ps, memory_pressure or sysctl reading, any parse or I/O error; a malformed ps row is
an abort, never skipped). Cleanup runs in a finally block for every outcome: SIGTERM to the group,
5 s grace, then SIGKILL repeated until the kernel reports the group empty (os.killpg(pgid, 0) ->
ProcessLookupError), for at most 60 s. If the group still cannot be verified empty, macguard exits
125 and hands the group to the sentinel, which keeps the lock and keeps sending SIGKILL until the
group is empty. A leader that exits normally with descendants left in its group gets the same
cleanup. SIGINT/SIGTERM/SIGHUP to macguard abort the job the same way (exit 130).

Exit status: CMD's status if it ran to completion (128 + signal if a signal ended it); 124 the
guard aborted the job (resource, timeout, monitoring or logging failure), whatever CMD returned;
130 macguard was interrupted; 125 the guard's own machinery failed (sentinel, gate, process group
not verifiable or not empty after cleanup; the lock then stays with the sentinel); 3 refused to
start; 2 usage error.

Log: <dir>/logs/macguard.log (dir = $MACGUARD_DIR, default
/Users/ajbarry/wilderness-labs-stt-artifacts/parakeet-ios): start and end, kill reason, peak group
RSS, exit status, free memory, swap growth, load average and the top 5 CPU processes at start and
end, and the sentinel's actions. RSS polling can miss short peaks and memory used by system
services on the job's behalf. Standard library only (the Mac's /usr/bin/python3 is 3.9). The
probes are macOS commands; on Linux (tests only) /proc/meminfo stands in for memory and swap.
"""
from __future__ import annotations

import errno
import fcntl
import os
import select
import signal
import subprocess
import sys
import time

EXIT_USAGE, EXIT_REFUSED, EXIT_ABORTED, EXIT_INTERNAL, EXIT_INTERRUPTED = 2, 3, 124, 125, 130
DARWIN = sys.platform == "darwin"
DEFAULT_DIR = "/Users/ajbarry/wilderness-labs-stt-artifacts/parakeet-ios"
GRACE_S, KILL_DEADLINE_S, PROBE_TIMEOUT_S, ACK_TIMEOUT_S = 5.0, 60.0, 15.0, 10.0
USAGE = ("usage: macguard --rss-cap SIZE --timeout SECONDS [--min-free PCT] [--abort-free PCT] "
         "[--max-swap-growth SIZE] [--threads N] -- CMD ...")


class ProbeError(Exception):
    pass


# --- arguments ------------------------------------------------------------------------------------

def to_kb(size: str) -> int:
    """SIZE with optional K/M/G suffix (binary units; no suffix = bytes) -> KB."""
    units = {"k": 1, "m": 1024, "g": 1024 * 1024}
    if size and size[-1].lower() in units:
        return int(size[:-1]) * units[size[-1].lower()]
    return int(size) // 1024


def parse(argv: list) -> tuple:
    opts = {"rss-cap": None, "timeout": None, "min-free": "40", "abort-free": "25", "max-swap-growth": "1G",
            "threads": "4"}
    i = 0
    while i < len(argv) and argv[i] != "--":
        key = argv[i][2:] if argv[i].startswith("--") else None
        if key not in opts or i + 1 >= len(argv):
            raise ValueError(argv[i])
        opts[key] = argv[i + 1]
        i += 2
    cmd = argv[i + 1:] if i < len(argv) else []
    if not cmd or opts["rss-cap"] is None or opts["timeout"] is None:
        raise ValueError("missing --rss-cap, --timeout or CMD")
    parsed = {"cap_kb": to_kb(opts["rss-cap"]), "cap": opts["rss-cap"], "timeout": int(opts["timeout"]),
              "min_free": int(opts["min-free"]), "abort_free": int(opts["abort-free"]),
              "growth_kb": to_kb(opts["max-swap-growth"]), "growth": opts["max-swap-growth"],
              "threads": int(opts["threads"])}
    if min(parsed["cap_kb"], parsed["timeout"], parsed["threads"]) <= 0:
        raise ValueError("cap, timeout and threads must be positive")
    return parsed, cmd


# --- probes (every failure or malformed reading raises ProbeError) ----------------------------------

def run_probe(args: list) -> str:
    try:
        out = subprocess.run(args, capture_output=True, text=True, timeout=PROBE_TIMEOUT_S)
    except (OSError, subprocess.SubprocessError, ValueError) as exc:
        raise ProbeError(f"{args[0]}: {exc}") from exc
    if out.returncode != 0:
        raise ProbeError(f"{args[0]} exited {out.returncode}")
    return out.stdout


def free_pct() -> int:
    try:
        if DARWIN:
            lines = [l for l in run_probe(["memory_pressure", "-Q"]).splitlines() if "free percentage" in l]
            if len(lines) != 1:
                raise ProbeError("memory_pressure: no single free percentage line")
            value = int(lines[0].split(":")[1].strip().rstrip("%"))
        else:
            info = _meminfo()
            value = int(100 * info["MemAvailable"] / info["MemTotal"])
    except (ValueError, IndexError, KeyError, ZeroDivisionError) as exc:
        raise ProbeError(f"free memory: {exc!r}") from exc
    if not 0 <= value <= 100:
        raise ProbeError(f"free memory {value}% out of range")
    return value


def swap_used_kb() -> int:
    try:
        if DARWIN:
            fields = run_probe(["sysctl", "-n", "vm.swapusage"]).split()
            value = fields[fields.index("used") + 2]
            scale = {"K": 1, "M": 1024, "G": 1024 * 1024}[value[-1]]
            used = int(float(value[:-1]) * scale)
        else:
            info = _meminfo()
            used = info["SwapTotal"] - info["SwapFree"]
    except (ValueError, IndexError, KeyError) as exc:
        raise ProbeError(f"swap usage: {exc!r}") from exc
    if used < 0:
        raise ProbeError(f"swap usage {used}KB negative")
    return used


def _meminfo() -> dict:
    try:
        with open("/proc/meminfo") as handle:
            return {k: int(v.split()[0]) for k, v in (line.split(":", 1) for line in handle)}
    except (OSError, ValueError, IndexError) as exc:
        raise ProbeError(f"/proc/meminfo: {exc!r}") from exc


def group_rss_kb(pgid: int) -> int:
    """Summed RSS (KB) of the processes in process group pgid; every ps row must parse."""
    total, rows = 0, 0
    for line in run_probe(["ps", "-A", "-o", "pid=,pgid=,rss="]).splitlines():
        if not line.strip():
            continue
        parts = line.split()
        try:
            if len(parts) != 3:
                raise ValueError(line)
            pid, group, rss = (int(p) for p in parts)
        except ValueError as exc:
            raise ProbeError(f"malformed ps row {line!r}") from exc
        if pid <= 0 or rss < 0:
            raise ProbeError(f"malformed ps row {line!r}")
        rows += 1
        if group == pgid:
            total += rss
    if rows == 0:
        raise ProbeError("ps listed no processes")
    return total


def group_alive(pgid: int) -> bool:
    """Whether any process (zombies included) is in group pgid, from the kernel."""
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def kill_group(pgid: int, sig: int) -> None:
    try:
        os.killpg(pgid, sig)
    except ProcessLookupError:
        pass


def escalate(pgid: int, reap=lambda: None, kill_deadline: float | None = KILL_DEADLINE_S) -> bool:
    """SIGTERM, up to GRACE_S, then SIGKILL every 0.5 s until the group is empty (or kill_deadline s pass)."""
    kill_group(pgid, signal.SIGTERM)
    end = time.monotonic() + GRACE_S
    while time.monotonic() < end:
        reap()
        if not group_alive(pgid):
            return True
        time.sleep(0.1)
    end = None if kill_deadline is None else time.monotonic() + kill_deadline
    while end is None or time.monotonic() < end:
        kill_group(pgid, signal.SIGKILL)
        for _ in range(5):
            reap()
            if not group_alive(pgid):
                return True
            time.sleep(0.1)
    return False


# --- logging ----------------------------------------------------------------------------------------

def log(path: str, tag: str, message: str, echo: bool = True) -> None:
    """Append one line to the log (OSError propagates) and echo it to stderr (errors ignored)."""
    line = f"{time.strftime('%Y-%m-%dT%H:%M:%S')} [{tag}] {message}"
    with open(path, "a") as handle:
        handle.write(line + "\n")
    if echo:
        try:
            print(f"macguard: {message}", file=sys.stderr, flush=True)
        except (OSError, ValueError):
            pass


def log_safe(path: str, tag: str, message: str, echo: bool = True) -> None:
    try:
        log(path, tag, message, echo)
    except OSError:
        pass


# --- sentinel -----------------------------------------------------------------------------------------

def sentinel(ctrl_r: int, ack_w: int, lock_fd: int, supervisor: int, log_path: str) -> None:
    """Child of the supervisor in its own session; holds the lock until the job group is gone (see module doc)."""
    os.setsid()
    for signum in (signal.SIGINT, signal.SIGHUP, signal.SIGTERM):
        signal.signal(signum, signal.SIG_IGN)
    null = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(null, fd)
    keep = {0, 1, 2, ctrl_r, ack_w, lock_fd}
    for fd in range(3, 1024):
        if fd not in keep:
            try:
                os.close(fd)
            except OSError:
                pass
    tag = f"sentinel {os.getpid()}"
    pgid, buffer = None, b""
    while True:
        ready, _, _ = select.select([ctrl_r], [], [], 1.0)
        message = None
        if ready:
            data = os.read(ctrl_r, 4096)
            if not data:
                message = "eof"
            else:
                buffer += data
                while b"\n" in buffer and message is None:
                    line, buffer = buffer.split(b"\n", 1)
                    words = line.decode().split()
                    if words[:1] == ["pgid"]:
                        pgid = int(words[1])
                        os.write(ack_w, b"ok\n")
                    elif words[:1] in (["done"], ["watch"]):
                        message = words[0]
        elif os.getppid() != supervisor:
            message = "eof"
        if message == "done":
            return
        if message == "watch":
            log_safe(log_path, tag, f"supervisor could not verify group {pgid} empty; killing until it is", False)
            escalate(pgid, kill_deadline=None)
            log_safe(log_path, tag, f"group {pgid} empty; releasing the lock", False)
            return
        if message == "eof":
            if pgid is None:
                log_safe(log_path, tag, "supervisor gone before the job was released; nothing to clean up", False)
                return
            log_safe(log_path, tag, f"supervisor {supervisor} gone; terminating job group {pgid}", False)
            escalate(pgid, kill_deadline=None)
            log_safe(log_path, tag, f"group {pgid} empty; releasing the lock", False)
            return


# --- supervisor ---------------------------------------------------------------------------------------

class Guard:
    def __init__(self, opts: dict, cmd: list, directory: str) -> None:
        self.opts, self.cmd, self.dir = opts, cmd, directory
        self.log_path = os.path.join(directory, "logs", "macguard.log")
        self.tag = str(os.getpid())
        self.interrupted = 0

    def say(self, message: str) -> None:
        log(self.log_path, self.tag, message)

    def say_safe(self, message: str) -> None:
        log_safe(self.log_path, self.tag, message)

    def snapshot(self, label: str, free: object, swap: object, strict: bool) -> None:
        say = self.say if strict else self.say_safe
        load = " ".join(f"{x:.2f}" for x in os.getloadavg())
        say(f"{label}: free {free}% swap_used {swap}KB load {load}")
        try:
            args = (["ps", "-A", "-r", "-o", "pid=,pcpu=,rss=,comm="] if DARWIN
                    else ["ps", "-A", "-o", "pid=,pcpu=,rss=,comm=", "--sort=-pcpu"])
            for line in run_probe(args).splitlines()[:5]:
                say(f"{label}: top {line.strip()}")
        except ProbeError as exc:
            say(f"{label}: top unavailable ({exc})")

    def on_signal(self, signum, frame) -> None:
        self.interrupted = signum

    def run(self) -> int:
        lock_fd = os.open(os.path.join(self.dir, "macguard.lockfile"), os.O_RDWR | os.O_CREAT, 0o644)
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError as exc:
            os.close(lock_fd)
            if exc.errno in (errno.EWOULDBLOCK, errno.EAGAIN):
                self.say_safe(f"refused: lock held by another guarded job: {' '.join(self.cmd)}")
                return EXIT_REFUSED
            raise
        try:
            free0, swap0 = free_pct(), swap_used_kb()
        except ProbeError as exc:
            self.say_safe(f"refused: cannot read memory state ({exc}): {' '.join(self.cmd)}")
            return EXIT_REFUSED
        if free0 < self.opts["min_free"]:
            self.say_safe(f"refused: free memory {free0}% < {self.opts['min_free']}%: {' '.join(self.cmd)}")
            return EXIT_REFUSED
        for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(signum, self.on_signal)
        ctrl_r, ctrl_w = os.pipe()
        ack_r, ack_w = os.pipe()
        child = os.fork()
        if child == 0:
            try:
                sentinel(ctrl_r, ack_w, lock_fd, os.getppid(), self.log_path)
            finally:
                os._exit(0)
        os.close(ctrl_r)
        os.close(ack_w)
        return self.supervise(lock_fd, ctrl_w, ack_r, child, free0, swap0)

    def supervise(self, lock_fd: int, ctrl_w: int, ack_r: int, sentinel_pid: int, free0: int, swap0: int) -> int:
        opts = self.opts
        start = time.monotonic()
        reason, internal, proc, pgid, peak, phase = None, None, None, None, 0, "start"
        try:
            self.say(f"start: cap {opts['cap']} ({opts['cap_kb']}KB) timeout {opts['timeout']}s threads "
                     f"{opts['threads']} min_free {opts['min_free']}% abort_free {opts['abort_free']}% "
                     f"max_swap_growth {opts['growth']} sentinel {sentinel_pid}: {' '.join(self.cmd)}")
            self.snapshot("start", free0, swap0, strict=True)
            env = dict(os.environ)
            for key in ("OMP_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "MKL_NUM_THREADS", "OPENBLAS_NUM_THREADS",
                        "NUMEXPR_NUM_THREADS"):
                env[key] = str(opts["threads"])
            phase = "launch"
            gate_r, gate_w = os.pipe()
            try:
                proc = subprocess.Popen([sys.executable, os.path.abspath(__file__), "--exec-after-gate", str(gate_r),
                                         "--", *self.cmd], env=env, start_new_session=True,
                                        pass_fds=(lock_fd, gate_r), preexec_fn=lambda: os.nice(10))
                os.close(gate_r)
                pgid = proc.pid
                if os.getpgid(pgid) != pgid or pgid == os.getpgrp():
                    raise RuntimeError(f"job is not in its own process group (pgid {os.getpgid(pgid)})")
                os.write(ctrl_w, f"pgid {pgid}\n".encode())
                ready, _, _ = select.select([ack_r], [], [], ACK_TIMEOUT_S)
                if not ready or os.read(ack_r, 16) != b"ok\n":
                    raise RuntimeError("sentinel did not acknowledge the job's process group")
                os.write(gate_w, b"g")
            finally:
                os.close(gate_w)
            phase = "monitor"
            tick = 0
            while True:
                if self.interrupted:
                    reason = f"macguard received {signal.Signals(self.interrupted).name}"
                    break
                if proc.poll() is not None:
                    break
                try:
                    rss = group_rss_kb(pgid)
                    peak = max(peak, rss)
                    elapsed = time.monotonic() - start
                    if rss > opts["cap_kb"]:
                        reason = f"rss {rss}KB > cap {opts['cap_kb']}KB"
                    elif elapsed > opts["timeout"]:
                        reason = f"timeout {elapsed:.1f}s > {opts['timeout']}s"
                    elif tick % 5 == 0:
                        free, swap = free_pct(), swap_used_kb()
                        if free < opts["abort_free"]:
                            reason = f"system free memory {free}% < {opts['abort_free']}%"
                        elif swap - swap0 > opts["growth_kb"]:
                            reason = f"swap grew {swap - swap0}KB > {opts['growth_kb']}KB"
                except Exception as exc:  # monitoring and logging failures abort the job (fail closed)
                    reason = f"monitoring failed: {exc!r}"
                if reason:
                    break
                tick += 1
                time.sleep(1.0)
        except Exception as exc:  # start-up logging or monitoring failure: abort; launch failure: internal
            if phase == "launch":
                internal = repr(exc)
            else:
                reason = f"{'logging' if phase == 'start' else 'monitoring'} failed: {exc!r}"
        finally:
            empty = True
            if pgid is not None:
                leftover = reason is None and internal is None and group_alive(pgid)
                if leftover:
                    self.say_safe(f"job leader exited with processes left in group {pgid}; terminating them")
                if reason or internal or leftover:
                    empty = escalate(pgid, reap=proc.poll)
            elif proc is not None:
                proc.kill()
            if proc is not None:
                try:
                    proc.wait(timeout=KILL_DEADLINE_S)
                except subprocess.TimeoutExpired:
                    empty = False
            try:
                os.write(ctrl_w, b"done\n" if empty else b"watch\n")
            except OSError as exc:
                self.say_safe(f"ERROR: cannot reach the sentinel {sentinel_pid}: {exc!r}")
            if empty:
                try:
                    os.waitpid(sentinel_pid, 0)
                except ChildProcessError:
                    pass
            else:
                self.say_safe(f"ERROR: process group {pgid} not empty after SIGKILL for {KILL_DEADLINE_S:.0f}s; "
                              f"the sentinel {sentinel_pid} keeps the lock and keeps killing it")
            os.close(ctrl_w)
            os.close(ack_r)
            os.close(lock_fd)  # never LOCK_UN: the lock lasts while any holder of the description lives
        code = proc.returncode if proc is not None and proc.returncode is not None else 0
        child_status = 128 - code if code < 0 else code
        if internal or not empty:
            status = EXIT_INTERNAL
        elif self.interrupted:
            status = EXIT_INTERRUPTED
        elif reason:
            status = EXIT_ABORTED
        else:
            status = child_status
        try:
            free1, swap1 = free_pct(), swap_used_kb()
            growth = f"{swap1 - swap0}KB"
        except ProbeError as exc:
            free1, swap1, growth = "?", "?", f"unknown ({exc})"
        why = reason or (f"internal error: {internal}" if internal else "")
        self.say_safe(f"end: status {status} (job {child_status}) after {time.monotonic() - start:.0f}s, peak group "
                      f"RSS {peak}KB, swap growth {growth}{', killed: ' + why if why else ''}")
        self.snapshot("end", free1, swap1, strict=False)
        return status


def exec_after_gate(argv: list) -> int:
    """Job wrapper: wait for the supervisor's go on the gate pipe, then exec CMD (127 if not found)."""
    fd = int(argv[0])
    data = os.read(fd, 1)
    os.close(fd)
    if data != b"g":
        return EXIT_INTERNAL
    cmd = argv[2:]
    try:
        os.execvp(cmd[0], cmd)
    except OSError as exc:
        print(f"macguard: cannot run {cmd[0]}: {exc}", file=sys.stderr)
        return 127


def main() -> int:
    if sys.argv[1:2] == ["--exec-after-gate"]:
        return exec_after_gate(sys.argv[2:])
    try:
        opts, cmd = parse(sys.argv[1:])
    except ValueError:
        print(USAGE, file=sys.stderr)
        return EXIT_USAGE
    directory = os.environ.get("MACGUARD_DIR", DEFAULT_DIR if DARWIN else "")
    if not directory:
        print("macguard: set MACGUARD_DIR (no default outside macOS)", file=sys.stderr)
        return EXIT_USAGE
    try:
        os.makedirs(os.path.join(directory, "logs"), exist_ok=True)
    except OSError as exc:
        print(f"macguard: cannot create {directory}/logs: {exc}", file=sys.stderr)
        return EXIT_REFUSED
    return Guard(opts, cmd, directory).run()


if __name__ == "__main__":
    sys.exit(main())
