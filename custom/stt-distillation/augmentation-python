#!/usr/bin/env bash
set -euo pipefail
mountpoint -q /mnt/hd || { echo '/mnt/hd is not mounted' >&2; exit 1; }
stt_aug_base=/mnt/hd/wilderness-labs-stt/stt-distillation
export PYTHONPATH="$stt_aug_base/deps"
export HF_HOME="$stt_aug_base/caches/hf" HF_DATASETS_CACHE="$stt_aug_base/caches/datasets"
export XDG_CACHE_HOME="$stt_aug_base/caches" TORCH_HOME="$stt_aug_base/caches/torch"
export NUMBA_CACHE_DIR="$stt_aug_base/caches/numba" TMPDIR="$stt_aug_base/caches/tmp"
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
export DO_NOT_TRACK=1 WANDB_MODE=disabled TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1
export LD_LIBRARY_PATH="$stt_aug_base/augmentation-pilot/runtime/gcc/lib:/run/opengl-driver/lib"
exec "$stt_aug_base/augmentation-pilot/runtime/training/bin/python3" "$@"
